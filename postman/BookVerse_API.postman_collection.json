          "event": [{ "listen": "pre-request", "script": { "type": "text/javascript", "exec": ["pm.variables.replaceIn('{{$guid}}', (error, value) => pm.request.headers.upsert({ key: 'Idempotency-Key', value }));"] } }, { "listen": "test", "script": { "type": "text/javascript", "exec": ["const response = pm.response.json();", "if (response.data?.id) pm.collectionVariables.set('orderId', response.data.id);"] } }],
          "request": {
