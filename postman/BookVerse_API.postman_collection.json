            "body": { "mode": "raw", "raw": "{\n  \"quote_id\": \"{{quoteId}}\",\n  \"address_id\": \"{{addressId}}\",\n  \"shipping_method_id\": \"standard\",\n  \"payment_method\": \"cod\",\n  \"customer_note\": \"Call before delivery\"\n}" },
